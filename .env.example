# Optional locally; required on Vercel for contact/newsletter storage.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Instagram management also accepts the managed integration's matching
# storage_TURSO_DATABASE_URL / storage_TURSO_AUTH_TOKEN pair when the primary URL is empty.

# Canonical origin; production DNS and HTTPS are active.
BEURSWATCHER_SITE_URL=https://www.beurswatcher.nl

# Add only after the Instagram account connection is available.
# Legacy manual connection (optional when the owner uses the connection page).
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Optional environment-managed Meta app configuration. Daniel can instead save
# his Instagram app credentials securely at /beheer/instagram; no redeploy needed.
# A complete environment pair takes precedence. Never use NEXT_PUBLIC_ here.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USERNAME=beurswatcher
# Optional explicit keys: connect secret >=43 chars, encryption key 32 bytes base64.
# Otherwise separate purpose-specific keys are derived from the strong admin
# session secret. Do not rotate that master secret without migrating stored data.
INSTAGRAM_CONNECT_SECRET=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Private Instagram management and encrypted self-service setup.
# Hash a random access code with scripts/create-instagram-admin.mjs.
INSTAGRAM_ADMIN_CODE_HASH=
INSTAGRAM_ADMIN_SESSION_SECRET=
# Optional development-only origin, to test the flow separately from canonical SEO URLs.
# INSTAGRAM_DEVELOPMENT_ORIGIN=http://127.0.0.1:5198
