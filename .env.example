# Optional locally; required on Vercel for contact/newsletter storage.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Build-time canonical origin. Leave the current URL until domain activation.
# After DNS and HTTPS are verified, set https://www.beurswatcher.nl in Production
# and rebuild. This also activates redirects from the old host and the apex domain.
BEURSWATCHER_SITE_URL=https://beurswatcher.vercel.app

# Add only after the Instagram account connection is available.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
